// The CORDIC co-processor, after the STM32G4 (RM0440).
//
// The functions' scale requirements are carried over from stm32-spa's description, and have not
// been checked against the reference manual.

/// A two-state enable.
schema toggle {
    variant Disabled ~ 0
    variant Enabled ~ 1
}

/// The value format of an argument or result.
schema size {
    /// 1 sign bit, 31 fractional bits.
    variant Q31 ~ 0
    /// 1 sign bit, 15 fractional bits.
    variant Q15 ~ 1
}

/// A count of one or two.
schema count {
    variant One ~ 0
    variant Two ~ 1
}

/// The CORDIC co-processor.
peripheral cordic {
    /// Control and status register.
    register csr @ 0x0
        reset 0x50
    {
        /// Function.
        store field func @ 3:0 {
            variant [Cos, Sin] ~ [0, 1]
                requires scale.N0
            variant Atan2 ~ 2
                requires scale.N0
            variant Magnitude ~ 3
                requires scale.N0
            variant Cosh ~ 4
                requires scale.N0
            variant Sinh ~ 5
                requires scale.N0
            variant Atanh ~ 6
                requires scale.N0
            variant Ln ~ 7
                requires scale.{N1, N2, N3, N4}
            variant Sqrt ~ 8
                requires scale.{N0, N1, N2}
        }

        /// Precision: the number of iterations, in steps of four.
        store field precision @ 7:4 {
            variant P[4, ... by 4] ~ [1..=15]
        }

        /// Scaling factor.
        store field scale @ 10:8 {
            variant N[0..8] ~ [0..8]
        }

        /// Interrupt enable.
        store field ien @ 16
            assumes toggle

        /// DMA read and write request enables.
        store field dmaren @ 17
            assumes toggle
        store field dmawen @ 18
            assumes toggle

        /// The number of results to read, and of arguments to write.
        store field nres @ 19
            assumes count
        store field nargs @ 20
            assumes count

        /// The formats of results and of arguments.
        store field ressize @ 21
            assumes size
        store field argsize @ 22
            assumes size

        /// Result ready.
        read field rrdy @ 31 {
            variant NoData ~ 0
            variant Ready ~ 1
        }
    }

    /// Argument data register: one 32-bit argument, or two 16-bit arguments.
    register wdata @ 0x4 {
        write field arg @ 31:0
            requires csr.argsize.Q31
        write field arg[0, 1] @ [15:0, 31:16]
            requires csr.argsize.Q15 & csr.nargs.One
    }

    /// Result data register: one 32-bit result, or two 16-bit results.
    register rdata @ 0x8 {
        read field res @ 31:0
            requires csr.ressize.Q31
        read field res[0, 1] @ [15:0, 31:16]
            requires csr.ressize.Q15 & csr.nres.One
    }
}

device g431 {
    /// Reset and clock control (only what CORDIC needs).
    peripheral rcc @ 0x4002_1000 {
        /// AHB1 peripheral clock enable register.
        register ahb1enr @ 0x48
            reset 0x100
        {
            store field cordicen @ 3
                assumes toggle
        }
    }

    peripheral cordic @ 0x4002_0c00
        refines cordic
        requires rcc.ahb1enr.cordicen.Enabled
}
