//! Direct memory access, after the STM32G4 (RM0440): one template serving the six-channel DMAs of
//! the G431 and the eight-channel DMAs of the G474.

/// A two-state enable.
schema toggle {
    variant Disabled ~ 0
    variant Enabled ~ 1
}

/// An event flag.
schema event {
    variant NoEvent ~ 0
    variant Occurred ~ 1
}

/// An event flag clearer.
schema clear {
    inert variant Noop ~ 0
    variant Clear ~ 1
}

/// The direction of a transfer.
schema direction {
    variant FromPeripheral ~ 0
    variant FromMemory ~ 1
}

/// The size of a transfer at either end.
schema size {
    variant Bits8 ~ 0
    variant Bits16 ~ 1
    variant Bits32 ~ 2
}

/// The priority of a channel.
schema priority {
    variant Low ~ 0
    variant Medium ~ 1
    variant High ~ 2
    variant VeryHigh ~ 3
}

/// A DMA controller. The number of channels is left open, for each instance to close.
peripheral dma {
    /// Interrupt status register: four flags per channel.
    register isr @ 0x0 {
        group ch[1, ...] @ [0, ...] {
            read field gif @ 0
                assumes event
            read field tcif @ 1
                assumes event
            read field htif @ 2
                assumes event
            read field teif @ 3
                assumes event
        }
    }

    /// Interrupt flag clear register: four clearers per channel.
    register ifcr @ 0x4 {
        group ch[1, ...] @ [0, ...] {
            write field cgif @ 0
                assumes clear
            write field ctcif @ 1
                assumes clear
            write field chtif @ 2
                assumes clear
            write field cteif @ 3
                assumes clear
        }
    }

    /// A channel's four registers.
    group ch[1, ...] @ [0x8, ... by 0x14] {
        /// Channel configuration register.
        register ccr @ 0x0
            reset 0
        {
            /// Channel enable.
            volatile store field en @ 0
                assumes toggle
                hardware write requires en.Enabled

            store field tcie @ 1
                assumes toggle
                write requires en.Disabled
            store field htie @ 2
                assumes toggle
                write requires en.Disabled
            store field teie @ 3
                assumes toggle
                write requires en.Disabled
            store field dir @ 4
                assumes direction
                write requires en.Disabled
            store field circ @ 5
                assumes toggle
                write requires en.Disabled
            store field pinc @ 6
                assumes toggle
                write requires en.Disabled
            store field minc @ 7
                assumes toggle
                write requires en.Disabled
            store field psize @ 9:8
                assumes size
                write requires en.Disabled
            store field msize @ 11:10
                assumes size
                write requires en.Disabled
            store field pl @ 13:12
                assumes priority
                write requires en.Disabled

            /// Memory-to-memory mode, which may not be circular.
            store field mem2mem @ 14
                assumes toggle
                write requires en.Disabled
            {
                variant Enabled
                    requires circ.Disabled
            }
        }

        /// Channel transfer count register.
        register cndtr @ 0x4
            reset 0
        {
            volatile store field ndt @ 15:0
                write requires ccr.en.Disabled
                hardware write requires ccr.en.Enabled
        }

        /// Channel peripheral address register, one field per transfer size.
        register cpar @ 0x8
            reset 0
        {
            store field pa8 @ 31:0
                requires ccr.psize.Bits8
                write requires ccr.en.Disabled
            store field pa16 @ 30:0
                requires ccr.psize.Bits16
                write requires ccr.en.Disabled
            store field pa32 @ 29:0
                requires ccr.psize.Bits32
                write requires ccr.en.Disabled
        }

        /// Channel memory address register, one field per transfer size.
        register cmar @ 0xc
            reset 0
        {
            store field ma8 @ 31:0
                requires ccr.msize.Bits8
                write requires ccr.en.Disabled
            store field ma16 @ 30:0
                requires ccr.msize.Bits16
                write requires ccr.en.Disabled
            store field ma32 @ 29:0
                requires ccr.msize.Bits32
                write requires ccr.en.Disabled
        }
    }
}

device g431 {
    /// Reset and clock control (only what DMA needs).
    peripheral rcc @ 0x4002_1000 {
        /// AHB1 peripheral clock enable register.
        register ahb1enr @ 0x48
            reset 0x100
        {
            store field dma[1, 2]en @ [0, ...]
                assumes toggle
        }
    }

    /// Two six-channel DMAs: the channel count is closed three times, once per group.
    peripheral dma[1, 2] as d @ [0x4002_0000, ... by 0x400]
        refines dma
        requires rcc.ahb1enr.dma[#d]en.Enabled
    {
        register isr { group ch[1..=6] }
        register ifcr { group ch[1..=6] }
        group ch[1..=6]
    }
}

device g474 {
    /// Reset and clock control (only what DMA needs).
    peripheral rcc @ 0x4002_1000 {
        /// AHB1 peripheral clock enable register.
        register ahb1enr @ 0x48
            reset 0x100
        {
            store field dma[1, 2]en @ [0, ...]
                assumes toggle
        }
    }

    /// Two eight-channel DMAs.
    peripheral dma[1, 2] as d @ [0x4002_0000, ... by 0x400]
        refines dma
        requires rcc.ahb1enr.dma[#d]en.Enabled
    {
        register isr { group ch[1..=8] }
        register ifcr { group ch[1..=8] }
        group ch[1..=8]
    }
}
