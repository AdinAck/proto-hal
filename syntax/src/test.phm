/// some docs included with the template
register moder @ 0 (0) // template specifying offset and reset of zero

peripheral group gpio {
    peripheral array gpio[a, b, c, d, e, f, g] @ [0400_0000, ...] {
        /// add some more docs in addition to the template docs
        register #moder { // template includes offset (shouldn't but does for the sake of demonstration)
            /// a doc comment which each field will have
            field array #mode|mode[0..=15] @ [0..1, ...] // trailing elipsis means auto increment such that fields are adjacent
        }
        register #ospeedr (0100_0000) { ... } // override template's reset
        ...
        register #pupdr @ c4 { // override template's offset
            ...
        }
    }
}

readwrite schema foo {
    variant Bar @ 0
    variant Baz @ 1 requires (a & b) | (a & c)
    // variant Baz @ 1 requires a & b
    // variant Baz @ 1 requires a | b
    // variant Baz @ 1 requires a
}
